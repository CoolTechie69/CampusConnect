# Copy to .env and fill in. Never commit .env — it is gitignored.

# Postgres connection string from Neon / Supabase / Render.
# Neon format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Set to "false" only for a local Postgres without TLS. Hosted providers need TLS.
DATABASE_SSL=true

# Sign JWTs. MUST be set to a unique random value in production — the server
# refuses to boot in production without it.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Restrict signups to your college domain. Subdomains are accepted too.
# Comma-separated for multiple domains. Leave empty to accept any valid email.
ALLOWED_EMAIL_DOMAINS=hitam.org

PORT=4000

# Only used in development, when Vite serves the frontend on its own port.
# In production the API serves the built client, so this is ignored.
CLIENT_ORIGIN=http://localhost:5173
